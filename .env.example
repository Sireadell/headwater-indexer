# To create or update a token visit https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# Wallet-reputation cross-check for CircularFunding/FunderFanOut/WalletLabel
# handlers. Get a free key at https://www.nansen.ai. Without this set, the
# indexer runs fine but Nansen lookups silently return null (documented
# behavior, see src/handlers/Headwater.ts).
NANSEN_API_KEY="<YOUR-NANSEN-API-KEY>"
